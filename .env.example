# Formspree is configured in src/lib/formEndpoints.js using the public endpoint
# https://formspree.io/f/xqpkjjkr. No Formspree environment variables are needed.

# Only needed when building for GitHub Pages (a project site served from
# /<repo-name>/). Leave unset for Vercel/Netlify/local dev.
# VITE_BASE_PATH=/your-repo-name/
